<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.company.board.mapper.CompanyMapper">
    <insert id="save" useGeneratedKeys="true" keyProperty="companyId">
        INSERT INTO company (company_name, company_type)
        VALUES (#{companyName}, #{companyType})
    </insert>

    <select id="findAll" resultType="Company">
        SELECT * FROM company ORDER BY company_type ASC, company_id ASC
    </select>

    <update id="update">
        UPDATE company
        SET company_name = #{companyName}, company_type = #{companyType}
        WHERE company_id = #{companyId}
    </update>

    <delete id="deleteById">
        DELETE FROM company WHERE company_id = #{companyId}
    </delete>
</mapper>
