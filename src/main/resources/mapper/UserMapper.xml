<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace에는 아까 만든 인터페이스의 '정확한 경로'를 입력해서 연결시킵니다. -->
<mapper namespace="com.company.board.mapper.UserMapper">

    <!-- 
        1. 회원가입 (INSERT) 
        useGeneratedKeys="true" AUTO_INCREMENT한 PK값 받기
        keyProperty="userId" 받은 값을 User의 userId에 저장
        #{ ... } = 자동 매핑(파라미터 바인딩) != ${ } 백틱이랑 다름
    -->
    <insert id="save" useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO user (login_id, password, name, role)
        VALUES (#{loginId}, #{password}, #{name}, #{role})
    </insert>

    <!-- 2. 로그인 아이디로 회원 찾기 -->
    <select id="findByLoginId" resultType="User">
        SELECT * 
        FROM user 
        WHERE login_id = #{loginId}
    </select>

    <!-- 3. 고유 식별 번호로 회원 찾기 -->
    <select id="findById" resultType="User">
        SELECT * 
        FROM user 
        WHERE user_id = #{userId}
    </select>

    <!-- 
        4. 전체 유저 목록 조회 
        결과가 List여도 resultType="User"로 지정하면 알아서 List<User>로 반환
        Flutter와는 다름
    -->
    <select id="findAll" resultType="User">
        SELECT * 
        FROM user 
        ORDER BY user_id DESC
    </select>

</mapper>
